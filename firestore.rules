rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only these two logins can read or change anything.
    function isMember() {
      return request.auth != null
        && request.auth.token.email in ['anubhav.iiitb@gmail.com', 'sulekha@sa-ledger.app'];
    }

    function str(v, max) { return v is string && v.size() <= max; }

    // Optional original currency: amount stays in EUR, origAmount is in 'currency', fxRate = EUR per unit.
    function validFx(d) {
      return (!('currency' in d) || (d.currency is string && d.currency.size() == 3))
        && (!('origAmount' in d) || (d.origAmount is number && d.origAmount > 0))
        && (!('fxRate' in d) || (d.fxRate is number && d.fxRate > 0));
    }

    function validExpense() {
      let d = request.resource.data;
      return d.keys().hasOnly(['amount','date','store','category','subcategory','account',
                               'spender','country','comment','createdAt','createdBy','updatedBy','tripId',
                               'currency','origAmount','fxRate'])
        && d.keys().hasAll(['amount','date','store','category','account','spender'])
        && d.amount is number && d.amount > 0 && d.amount < 1000000
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && str(d.store, 120) && d.store.size() > 0
        && str(d.category, 60) && str(d.account, 60) && str(d.spender, 40)
        && (!('subcategory' in d) || str(d.subcategory, 60))
        && (!('country' in d) || str(d.country, 60))
        && (!('comment' in d) || str(d.comment, 500))
        && (!('tripId' in d) || str(d.tripId, 60))
        && validFx(d);
    }

    match /expenses/{id} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && validExpense();
    }

    function validIncome() {
      let d = request.resource.data;
      return d.keys().hasOnly(['amount','date','source','category','account','earner',
                               'comment','createdAt','createdBy','updatedBy','currency','origAmount','fxRate'])
        && d.keys().hasAll(['amount','date','source','category','account','earner'])
        && d.amount is number && d.amount > 0 && d.amount < 10000000
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && str(d.source, 120) && d.source.size() > 0
        && str(d.category, 60) && str(d.account, 60) && str(d.earner, 40)
        && (!('comment' in d) || str(d.comment, 500))
        && validFx(d);
    }

    match /income/{id} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && validIncome();
    }

    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    function validTrip() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','type','traveller','start','end','budget','notes','currency','closed',
                               'createdAt','createdBy','updatedBy'])
        && d.keys().hasAll(['name','type','traveller'])
        && str(d.name, 80) && d.name.size() > 0
        && d.type in ['visit','holiday','other','office']
        && d.traveller in ['Anubhav','Sulekha','Both']
        && (!('start' in d) || isDate(d.start))
        && (!('end' in d) || isDate(d.end))
        && (!('budget' in d) || (d.budget is number && d.budget >= 0 && d.budget < 1000000))
        && (!('notes' in d) || str(d.notes, 1000))
        && (!('currency' in d) || (d.currency is string && d.currency.size() == 3))
        && (!('closed' in d) || d.closed is bool);
    }

    match /trips/{id} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && validTrip();
    }

    // Shared settings: 'budgets', 'fire' and 'fireInr' (FIRE plans in euros and rupees), 'fx' (rate on the 1st of each month)
    // and 'bookings' (the address booking emails are forwarded to).
    function validBudgets() {
      let d = request.resource.data;
      return d.keys().hasOnly(['items','total','updatedAt','updatedBy'])
        && d.items is list && d.items.size() <= 100
        && (!('total' in d) || (d.total is number && d.total >= 0));
    }
    function optNum(d, k) { return !(k in d) || d[k] is number; }
    function validFire() {
      let d = request.resource.data;
      return d.keys().hasOnly(['expenses','inflation','fireYear','withdrawal','savings','returnPct','updatedAt','updatedBy'])
        && optNum(d, 'expenses') && optNum(d, 'inflation') && optNum(d, 'fireYear')
        && optNum(d, 'withdrawal') && optNum(d, 'savings') && optNum(d, 'returnPct');
    }
    function validBookingSettings() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email','updatedAt','updatedBy']) && str(d.email, 120);
    }
    function validFxMonths() {
      let d = request.resource.data;
      return d.keys().hasOnly(['months','updatedAt','updatedBy']) && d.months is map;
    }

    match /settings/{id} {
      allow read: if isMember();
      allow write: if isMember() && (
           (id == 'budgets' && validBudgets())
        || ((id == 'fire' || id == 'fireInr') && validFire())
        || (id == 'fx' && validFxMonths())
        || (id == 'bookings' && validBookingSettings()));
    }

    // Money moved between own accounts (incl. investing and card payments). Not spending.
    function validTransfer() {
      let d = request.resource.data;
      return d.keys().hasOnly(['amount','date','from','to','comment','createdAt','createdBy','updatedBy',
                               'currency','origAmount','fxRate'])
        && d.keys().hasAll(['amount','date','from','to'])
        && d.amount is number && d.amount > 0 && d.amount < 10000000
        && isDate(d.date)
        && str(d.from, 60) && d.from.size() > 0 && str(d.to, 60) && d.to.size() > 0
        && (!('comment' in d) || str(d.comment, 500))
        && validFx(d);
    }

    match /transfers/{id} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && validTransfer();
    }

    function validAccount() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','type','currency','owner','notes','createdAt','createdBy','updatedBy',
                               'invType','valueMode','returnPct','target','inFire'])
        && d.keys().hasAll(['name','type','currency','owner'])
        && str(d.name, 60) && d.name.size() > 0
        && d.type in ['bank','card','cash','investment']
        && d.currency is string && d.currency.size() == 3
        && d.owner in ['Anubhav','Sulekha','Shared']
        && (!('notes' in d) || str(d.notes, 500))
        && (!('invType' in d) || d.invType in ['equity','ulip','pension','deposit','no_growth','other'])
        && (!('valueMode' in d) || d.valueMode in ['manual','auto'])
        && (!('returnPct' in d) || (d.returnPct is number && d.returnPct >= -50 && d.returnPct <= 100))
        && (!('target' in d) || (d.target is number && d.target >= 0))
        && (!('inFire' in d) || d.inFire is bool);
    }

    match /accounts/{id} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && validAccount();
    }

    // A real balance typed in from the bank or broker app (card debt stored as a negative number).
    function validCheckin() {
      let d = request.resource.data;
      return d.keys().hasOnly(['accountId','date','balance','note','createdAt','createdBy','updatedBy'])
        && d.keys().hasAll(['accountId','date','balance'])
        && str(d.accountId, 60) && isDate(d.date)
        && d.balance is number && d.balance > -100000000 && d.balance < 100000000
        && (!('note' in d) || str(d.note, 500));
    }

    match /checkins/{id} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && validCheckin();
    }

    // One month of an investment account: money put in that month and the value at month end
    // (value left out on modelled months). Document id is <accountId>_<YYYY-MM>.
    function validSnapshot() {
      let d = request.resource.data;
      return d.keys().hasOnly(['accountId','month','investment','value','opening','note','createdAt','createdBy','updatedBy'])
        && d.keys().hasAll(['accountId','month','investment'])
        && str(d.accountId, 60)
        && d.month is string && d.month.matches('^[0-9]{4}-[0-9]{2}$')
        && d.investment is number && d.investment > -1000000000 && d.investment < 1000000000
        && (!('value' in d) || (d.value is number && d.value >= 0 && d.value < 10000000000))
        && (!('opening' in d) || d.opening is bool)
        && (!('note' in d) || str(d.note, 500));
    }

    match /invSnapshots/{id} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && validSnapshot();
    }

    // Captured payment notifications. Only the capture function (server, admin access) creates them;
    // the app reads them and deletes each one once it's added or dismissed.
    match /inbox/{id} {
      allow read, delete: if isMember();
      allow create, update: if false;
    }

    // Tickets, boarding passes and hotel confirmations. codes holds the scanned QR/barcodes as small images;
    // the original file stays in Google Drive (fileId).
    function isDT(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2})?$'); }
    function validBooking() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tripId','type','title','provider','ref','number','travellers','start','end','from','to','address',
                               'seat','details','price','currency','codes','fileId','fileName','fileMime','source','expenseId',
                               'createdAt','createdBy','updatedBy'])
        && d.keys().hasAll(['type','title'])
        && d.type in ['flight','train','bus','ferry','hotel','car','event','restaurant','other']
        && str(d.title, 120) && d.title.size() > 0
        && (!('tripId' in d) || str(d.tripId, 60))
        && (!('provider' in d) || str(d.provider, 80))
        && (!('ref' in d) || str(d.ref, 40))
        && (!('number' in d) || str(d.number, 20))
        && (!('travellers' in d) || (d.travellers is list && d.travellers.size() <= 9))
        && (!('start' in d) || isDT(d.start))
        && (!('end' in d) || isDT(d.end))
        && (!('from' in d) || str(d.from, 80))
        && (!('to' in d) || str(d.to, 80))
        && (!('address' in d) || str(d.address, 200))
        && (!('seat' in d) || str(d.seat, 60))
        && (!('details' in d) || str(d.details, 300))
        && (!('price' in d) || (d.price is number && d.price >= 0 && d.price < 1000000))
        && (!('currency' in d) || (d.currency is string && d.currency.size() == 3))
        && (!('codes' in d) || (d.codes is list && d.codes.size() <= 8))
        && (!('fileId' in d) || str(d.fileId, 100))
        && (!('fileName' in d) || str(d.fileName, 160))
        && (!('fileMime' in d) || str(d.fileMime, 60))
        && (!('source' in d) || d.source in ['upload','email','share','paste'])
        && (!('expenseId' in d) || str(d.expenseId, 60));
    }

    match /bookings/{id} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && validBooking();
    }

    // Forwarded booking emails. Only the inbound function (server, admin access) creates them;
    // the app reads each one and deletes it once it's saved as bookings or dismissed.
    match /bookingInbox/{id} {
      allow read, delete: if isMember();
      allow create, update: if false;
    }

    // Everything else stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
