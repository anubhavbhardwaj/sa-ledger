{
  "name": "S&A Ledger",
  "short_name": "Ledger",
  "description": "Sulekha and Anubhav's shared expense tracker",
  "id": "/",
  "start_url": "/#overview",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F2F5F3",
  "theme_color": "#1F6F5C",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "url": "/#add",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Add booking",
      "url": "/#booking"
    },
    {
      "name": "Transactions",
      "url": "/#transactions"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/*"
          ]
        }
      ]
    }
  }
}
